// ============================================
// 🔒 FIRESTORE SECURITY RULES — Racoon Teacher (Dev & Admin Mode)
// ============================================
//
// 📌 CÓMO APLICAR ESTAS REGLAS EN FIREBASE:
//
// 1. Ve a https://console.firebase.google.com
// 2. Entra a tu proyecto (rakun-ca4d1)
// 3. En el menú izquierdo ve a "Firestore Database" > pestaña "Reglas" (Rules)
// 4. Pega exactamente este código y haz clic en "Publicar" (Publish)
//
// Esto permite que el panel de administración de desarrollo pueda
// crear, actualizar y eliminar registros de cualquier usuario.
// ============================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
